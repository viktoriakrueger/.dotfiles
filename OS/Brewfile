# Homebrew Taps (additional repositories for Homebrew)

tap "buo/cask-upgrade"  # Provides tools to upgrade Homebrew Casks
tap "common-fate/granted"  # Tools for managing credentials or access
tap "dracula/install"  # Dracula theme for various applications
tap "homebrew/bundle"  # Homebrew Bundle for managing Homebrew dependencies via a Brewfile
tap "homebrew/services"  # Manage background services with Homebrew
tap "koekeishiya/formulae"  # Koekeishiya's tools and utilities for macOS
tap "osx-cross/arm"  # Cross-compiling ARM binaries on macOS
tap "osx-cross/avr"  # Cross-compiling AVR binaries on macOS
tap "teamookla/speedtest"  # Ookla’s Speedtest CLI for testing internet speed

